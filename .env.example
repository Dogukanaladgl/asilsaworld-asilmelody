# Copy this file to `.env.local` and fill in real values.
# Next.js loads `.env.local` — not this example file.

# Public site URL (no trailing slash). Used for sitemap, canonical, Open Graph.
# Example: https://asilsaworld.com
NEXT_PUBLIC_SITE_URL=

# Get your key at: https://resend.com/api-keys

# Resend API key (starts with re_)
RESEND_API_KEY=

# Sender address.
# Without a verified domain, use Resend's test sender:
#   Asil's a World <onboarding@resend.dev>
# With a verified domain, use your own address, e.g.:
#   Asil's a World <hello@asilsaworld.com>
RESEND_FROM_EMAIL=Asil's a World <onboarding@resend.dev>

# Inbox for contact form + careers applications.
# With onboarding@resend.dev, Resend usually only delivers
# to the email address of your Resend account — verify a domain
# (or use an inbox tied to that account) for reliable delivery.
CONTACT_TO_EMAIL=asiildeniz@icloud.com

# --- Instagram live feed (Canlı Teslimat) ---
# Instagram Professional (Business/Creator) account + Meta Developer App.
# 1. https://developers.facebook.com/ → Create App → add Instagram
# 2. Generate a long-lived access token
# 3. Paste below. Until set, the section uses local fallback images.
#
# INSTAGRAM_ACCESS_TOKEN=
# Optional numeric IG user id (defaults to /me with the token):
# INSTAGRAM_USER_ID=
