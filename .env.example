# Copy this file to `.env.local` and fill in real values.
# Next.js loads `.env.local` — not this example file.
# Get your key at: https://resend.com/api-keys

# Resend API key (starts with re_)
RESEND_API_KEY=

# Sender address.
# Without a verified domain, use Resend's test sender:
#   Asil's a World <onboarding@resend.dev>
# With a verified domain, use your own address, e.g.:
#   Asil's a World <hello@asilsaworld.com>
RESEND_FROM_EMAIL=Asil's a World <onboarding@resend.dev>

# Inbox for contact form + careers applications.
# With onboarding@resend.dev, Resend usually only delivers
# to the email address of your Resend account.
CONTACT_TO_EMAIL=
